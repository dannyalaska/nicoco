// Piggyback — proximity delivery notification service
// Geography columns use PostGIS via Prisma's `Unsupported` type.
// PostGIS extension and GiST indexes are created in the first migration
// (see prisma/migrations/00000000000000_init_postgis). Geo reads/writes
// happen via raw SQL in src/lib/geo.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. On Supabase this is
  // the port 5432 connection string; DATABASE_URL is the pooler.
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// -------------------- Auth.js tables --------------------
// Standard Auth.js Prisma adapter schema.

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  subscriber    Subscriber?
  retailerUser  RetailerUser?
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------- Piggyback domain --------------------

enum IngestMode {
  manual
  webhook
  api
}

enum RetailerPlan {
  pilot
  pizza
  aggregator
}

enum DeliveryStatus {
  dispatched
  in_transit
  delivered
  cancelled
}

enum SourceAdapter {
  manual
  neighbor
  webhook
  square
  toast
  clover
  doordash
}

enum RetailerUserRole {
  owner
  staff
}

enum WaitlistType {
  retailer
  consumer
}

model Retailer {
  id             String       @id @default(cuid())
  name           String
  address        String
  // PostGIS: shop location (lon, lat). Managed via raw SQL.
  location       Unsupported("geography(Point,4326)")?
  webhookSecret  String       @unique
  ingestMode     IngestMode   @default(manual)
  plan           RetailerPlan @default(pilot)
  // Neighbor-run fields. A shop can be on the list without ever signing
  // up: neighbors post runs for it, and the offer page sends people to
  // the shop's own ordering page or phone.
  phone          String?
  orderUrl       String?
  category       String?
  // Shown on the list only when true. Admin flips it off for shops that
  // stop delivering or ask to be removed.
  listed         Boolean      @default(true)
  // Set once the shop has agreed to waive or cut the fee on same-run
  // orders. Free text so it can say exactly what they offered.
  sameRunPerk    String?
  createdAt      DateTime     @default(now())

  users      RetailerUser[]
  drivers    Driver[]
  deliveries Delivery[]
}

model RetailerUser {
  id         String           @id @default(cuid())
  retailerId String
  userId     String           @unique
  role       RetailerUserRole @default(owner)
  retailer   Retailer         @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([retailerId])
}

model Driver {
  id         String   @id @default(cuid())
  retailerId String
  name       String
  phone      String?
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  deliveries Delivery[]

  @@index([retailerId])
}

model Delivery {
  id                     String         @id @default(cuid())
  retailerId             String
  driverId               String?
  // PostGIS: origin + destination (lon, lat). Managed via raw SQL.
  // Both are nullable at the Prisma layer so `.create()` works — every
  // code path immediately patches `destLocation` via raw SQL in
  // src/lib/geo.ts::setDeliveryLocations. Prisma makes any model with
  // a required `Unsupported` column read-only, so we relax it here.
  originLocation         Unsupported("geography(Point,4326)")?
  destLocation           Unsupported("geography(Point,4326)")?
  destAddress            String?
  dispatchedAt           DateTime
  etaMinutes             Int?
  status                 DeliveryStatus @default(dispatched)
  sourceAdapter          SourceAdapter
  externalId             String?
  piggybackWindowMinutes Int            @default(10)
  rawPayload             Json?
  // Neighbor runs: who posted it and a coarse label ("near Main St")
  // instead of a street address. destLocation is snapped to a block grid.
  postedById             String?
  areaLabel              String?
  createdAt              DateTime       @default(now())

  retailer      Retailer       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  driver        Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  postedBy      Subscriber?    @relation("PostedRuns", fields: [postedById], references: [id], onDelete: SetNull)
  notifications Notification[]

  // Idempotent ingest: same (retailer, adapter, externalId) will upsert
  // the same Delivery row instead of duplicating.
  @@unique([retailerId, sourceAdapter, externalId])
  @@index([status, dispatchedAt])
  @@index([postedById, createdAt])
}

model Subscriber {
  id              String                                @id @default(cuid())
  userId          String                                @unique
  // PostGIS: home + current location (lon, lat). Managed via raw SQL.
  homeLocation    Unsupported("geography(Point,4326)")?
  currentLocation Unsupported("geography(Point,4326)")?
  // Neighbor runs only make sense a few blocks out. 600 m is roughly
  // a 7 minute walk.
  radiusMeters    Int                                   @default(600)
  active          Boolean                               @default(true)
  // Quiet hours in the subscriber's local time, 0 to 23. No pings when
  // the current hour is in [quietStartHour, quietEndHour).
  quietStartHour  Int                                   @default(22)
  quietEndHour    Int                                   @default(9)
  timeZone        String                                @default("America/New_York")
  // Notification fatigue cap.
  maxPerDay       Int                                   @default(3)
  createdAt       DateTime                              @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushSubs      PushSubscription[]
  notifications Notification[]
  postedRuns    Delivery[]         @relation("PostedRuns")
}

model PushSubscription {
  id           String     @id @default(cuid())
  subscriberId String
  endpoint     String     @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime   @default(now())
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
}

model Notification {
  id             String    @id @default(cuid())
  deliveryId     String
  subscriberId   String
  sentAt         DateTime  @default(now())
  deliveredAt    DateTime?
  clickedAt      DateTime?
  orderPlaced    Boolean   @default(false)
  orderedAt      DateTime?
  // Follow-up answer: did the order come on the same run? null = not answered.
  sameRun        Boolean?
  // Did the shop drop or cut the delivery fee? null = not answered.
  feeWaived      Boolean?
  distanceMeters Int

  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, subscriberId])
  @@index([subscriberId])
}

model WaitlistLead {
  id        String       @id @default(cuid())
  type      WaitlistType
  email     String
  name      String?
  business  String?
  city      String?
  zip       String?
  posSystem String?
  weeklyVolume String?
  source    String?
  note      String?
  createdAt DateTime     @default(now())

  @@index([type, createdAt])
}
