# ---- Database ----
# Local dev: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgis/postgis:16-3.4
# Prod (Supabase): DATABASE_URL is the pooled "Transaction" URL on port 6543
# with ?pgbouncer=true appended; DIRECT_URL is the direct URL on port 5432.
# Migrations use DIRECT_URL, the app uses DATABASE_URL. Locally both are the same.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/piggyback?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/piggyback?schema=public"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Comma-separated emails that get admin dashboard access
ADMIN_EMAILS="you@example.com"

# ---- Email (Resend) ----
# Get a key at resend.com. For local dev you can leave empty —
# magic links will be printed to the server console.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Piggyback <noreply@piggyback.app>"

# ---- Web Push / VAPID ----
# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# This MUST be the same as VAPID_PUBLIC_KEY — it is exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Contact address encoded into the VAPID token for push service operators.
VAPID_SUBJECT="mailto:founder@piggyback.app"
